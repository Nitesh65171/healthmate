<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">


        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Emergency Request"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tvSeverity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:padding="6dp"
            android:background="@drawable/bg_severity"/>
    </LinearLayout>


    <!-- PATIENT INFO -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patient Details"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvNameAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rahul Sharma • 32 yrs"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvEmergencyType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Type: Road Accident"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvSymptoms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Symptoms: Bleeding, Unconscious"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description: Severe head injury, needs immediate trauma care"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>


    <!-- LOCATION -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/tvAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NH-19 Highway, Agra"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnOpenMap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open in Maps"
        android:layout_marginTop="6dp"/>


    <!-- CONTACT -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contact"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="14dp"/>

    <TextView
        android:id="@+id/tvPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Primary: 9876543210"
        android:textSize="14sp"/>

    <TextView
        android:id="@+id/tvAltPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alternate: 9123456780"
        android:textSize="14sp"/>


    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/btnReject"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reject"
            android:backgroundTint="@android:color/darker_gray"/>

        <Button
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Accept"
            android:layout_marginStart="12dp"
            android:backgroundTint="@color/teal_700"/>
    </LinearLayout>

</LinearLayout>